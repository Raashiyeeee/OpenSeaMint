  "description": "Production-grade automated NFT collection-bidding and re-listing bot for OpenSea using Seaport protocol",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dry-run": "ts-node src/dryRun.ts",
